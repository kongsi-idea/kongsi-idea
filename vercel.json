{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/fuxi-admin(\\.html)?",
      "has": [
        {
          "type": "query",
          "key": "code",
          "value": "(?<code>.+)"
        }
      ],
      "destination": "/teacher.html?tool=tahun1-bc-fuxi-oktober&code=:code",
      "permanent": false
    },
    {
      "source": "/fuxi-admin(\\.html)?",
      "destination": "/teacher.html?tool=tahun1-bc-fuxi-oktober",
      "permanent": false
    },
